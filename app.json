{
  "expo": {
    "name": "ClientMobile",
    "slug": "client-mobile",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clientmobile"
    },
    "android": {
      "package": "com.clientmobile"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permita o acesso à câmera para escanear notas fiscais."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita o acesso às fotos para escolher a imagem de uma nota fiscal."
        }
      ]
    ]
  }
}
