{
  "expo": {
    "name": "ClientMobile",
    "slug": "client-mobile",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clientmobile",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "O ClientMobile usa a rede local para se conectar ao servidor de desenvolvimento.",
        "NSBonjourServices": [
          "_expo-dev-server._tcp",
          "_http._tcp"
        ]
      }
    },
    "android": {
      "package": "com.clientmobile"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
