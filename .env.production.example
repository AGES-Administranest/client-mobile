# Copy to `.env.production` and fill in with the production stack's values.
# `.env.production` is not committed.
#
# Expo loads this file instead of `.env` for every production build:
# `npm run web:build`, `npm run android:prod` and `npm run ios:prod`.
# `.env` is still read underneath for anything this file leaves out, so every
# variable is listed here, even the ones that stay empty.
#
# `.env.local` wins over this file. Don't keep one around when building for
# production.

# Shows "Continue with Google" on the welcome and login screens. Anything other
# than `production` keeps sign in to e-mail and password.
EXPO_PUBLIC_APP_ENV=production

# The production user pool's app client (public, no secret).
EXPO_PUBLIC_COGNITO_CLIENT_ID=

# Empty on purpose: the app builds the real Cognito address from the region.
# Leaving the line out would let the emulator address in `.env` through.
EXPO_PUBLIC_COGNITO_ENDPOINT=

EXPO_PUBLIC_AWS_REGION=us-east-1

# The user pool domain: https://<prefix>.auth.<region>.amazoncognito.com
EXPO_PUBLIC_COGNITO_OAUTH_URL=

# The Administranest API on AWS, over HTTPS.
EXPO_PUBLIC_API_URL=
