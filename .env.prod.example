# Copy to `.env.prod` and fill in with the production stack's values.
# `.env.prod` is not committed.
#
# Only the `:production` scripts read this file (`web:build:production`,
# `start:production`, `android:production`, `ios:production`); every other
# script stays on your local `.env`. It is `.env.prod` and not `.env.production`
# on purpose: Expo would load `.env.production` by itself on any release build.
#
# Every variable is required, even the one that stays empty, so nothing falls
# back to the local `.env`.

# Shows "Continue with Google" on the welcome and login screens. Anything other
# than `production` keeps sign in to e-mail and password.
EXPO_PUBLIC_APP_ENV=production

# The values below come from the backend's `scripts/deploy-cognito.sh`, which
# prints them. None of them is a secret.

# The production user pool's app client (public, no secret).
EXPO_PUBLIC_COGNITO_CLIENT_ID=4nu4qkganb11osbmk0njcu2aa

# Empty on purpose: the app builds the real Cognito address from the region.
EXPO_PUBLIC_COGNITO_ENDPOINT=

# The PUCRS account only allows us-east-2.
EXPO_PUBLIC_AWS_REGION=us-east-2

# The user pool domain.
EXPO_PUBLIC_COGNITO_OAUTH_URL=https://administranest-prod.auth.us-east-2.amazoncognito.com

# The Administranest API on AWS (App Runner, HTTPS).
EXPO_PUBLIC_API_URL=https://xeryjufmet.us-east-2.awsapprunner.com
