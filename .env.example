# Copy to `.env` and fill in. `.env` is not committed.
#
# These are inlined into the bundle by Expo (that is what the EXPO_PUBLIC_
# prefix means). Never put a secret here — and nothing here is one: the
# Cognito app client is public, deliberately created without a secret,
# because an installed app has nowhere to keep one.

# The user pool's app client. Locally: run `npm run dev:bootstrap` in the
# backend repo and copy the COGNITO_CLIENT_ID it writes to .aws-local.env.
EXPO_PUBLIC_COGNITO_CLIENT_ID=

# Cognito endpoint. Leave empty in production: with no value the app builds
# the real AWS address from the region. Set it only to point at the local
# emulator (MiniStack), which comes up with the backend.
#
# The Android emulator cannot see the host's `localhost` — use
# http://10.0.2.2:4566 there.
EXPO_PUBLIC_COGNITO_ENDPOINT=http://localhost:4566

# Pool region. Only used when the endpoint above is empty.
EXPO_PUBLIC_AWS_REGION=us-east-1

# The Administranest API. Cognito is where the app signs in; this is where
# everything else lives — starting with POST /auth/session, which creates the
# user's record on the first valid login.
#
# Locally it is the backend running outside Docker (`npm run start:dev` there),
# so the port comes from that repo's .env — 3000 unless you changed it. Same
# Android caveat as above: the emulator cannot see the host's `localhost`, use
# http://10.0.2.2:3000 there.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Sessão de desenvolvimento. Enquanto a tela de login não está ligada ao
# restante do app, o App.tsx popula o sessionStore a partir daqui — e sem
# sessão toda chamada de estoque falha, porque /item exige um userId UUID.
#
# Basta o token: rode `npm run dev:token` no repositório do backend e cole a
# saída aqui. Na subida o app chama POST /auth/session com ele e recebe de
# volta o userId (User.id, um UUID do banco — não é o `sub` do Cognito).
EXPO_PUBLIC_DEV_ID_TOKEN=

# Atalho opcional: com o userId preenchido o app pula a ida a /auth/session.
EXPO_PUBLIC_DEV_USER_ID=
